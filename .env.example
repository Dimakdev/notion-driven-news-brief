# Notion-driven news brief (n8n + Notion + Telegram). Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- n8n
# Settings -> n8n API -> Create an API key
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# The address this n8n is reachable at from the outside. Two things need it:
#   - the link wrapper /r?i=... that records a click before redirecting to the article
#   - Telegram callbacks from the weekly review buttons
# On plain localhost both work only on this machine. Put n8n behind a tunnel or a small VPS to read the
# brief on a phone. Leave as-is to try it on the desktop first.
PUBLIC_BASE_URL=http://localhost:5678

# ---------------------------------------------------------------- Notion
# Internal integration token: https://www.notion.so/my-integrations
# Capabilities needed: read content, update content, insert content.
NOTION_TOKEN=

# The page the five databases are created under. Open the page, Share -> connect your integration,
# then copy the id from its URL (the 32 hex characters at the end).
# Run scripts/deploy.py --create-databases once: it creates them and writes the ids into .deploy-state.json.
NOTION_PARENT_PAGE_ID=

# Filled in by deploy.py after the databases exist. Set them by hand only if you built the databases yourself.
NOTION_DB_TOPICS=
NOTION_DB_SOURCES=
NOTION_DB_FEED=
NOTION_DB_RUNS=
NOTION_DB_SETTINGS=
# Where the daily digest pages are created. deploy.py creates this database too.
NOTION_DB_BRIEFS=

# ---------------------------------------------------------------- model
# The workflow ships with Google Gemini (built with --provider gemini).
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only if you rebuild with --provider anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- delivery
# Telegram bot token from @BotFather, and the chat id that receives the brief.
# scripts/telegram_chat_id.py prints the chat id after you message the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
