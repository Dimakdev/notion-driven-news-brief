{
  "_comment": [
    "The control panel, as data. scripts/deploy.py reads this file and creates the databases in whatever",
    "Notion workspace you point it at, so nothing here is tied to one account.",
    "Two passes: databases first (no relations), then the relations, because a relation needs the id of a",
    "database that does not exist yet on the first pass. Multi-select options must exist before any row is",
    "written, so the seed vocabulary is declared here rather than created on the fly."
  ],
  "databases": {
    "topics": {
      "title": "Topics",
      "env": "NOTION_DB_TOPICS",
      "description": "What to look for. Criterion is the field that matters: it is what the model judges against. Threshold is the topic's volume knob.",
      "properties": {
        "Topic": {
          "title": {}
        },
        "Status": {
          "select": {
            "options": [
              {
                "name": "Active",
                "color": "green"
              },
              {
                "name": "Paused",
                "color": "gray"
              }
            ]
          }
        },
        "Criterion": {
          "rich_text": {}
        },
        "Signals": {
          "multi_select": {
            "options": []
          }
        },
        "Muted": {
          "multi_select": {
            "options": []
          }
        },
        "Languages": {
          "multi_select": {
            "options": [
              {
                "name": "uk",
                "color": "blue"
              },
              {
                "name": "en",
                "color": "blue"
              }
            ]
          }
        },
        "Window": {
          "number": {
            "format": "number"
          }
        },
        "Threshold": {
          "number": {
            "format": "number"
          }
        },
        "Priority": {
          "select": {
            "options": [
              {
                "name": "🔥 High",
                "color": "red"
              },
              {
                "name": "⚡ Medium",
                "color": "yellow"
              },
              {
                "name": "💤 Low",
                "color": "gray"
              }
            ]
          }
        },
        "Find sources": {
          "checkbox": {}
        }
      },
      "descriptions": {
        "Status": "Only Active topics are read on a run",
        "Criterion": "What you want and what you do not, in plain language. This is the text the model scores against",
        "Signals": "The cheap filter. Concepts plus names. LEAVING THIS EMPTY switches the keyword filter off for this topic",
        "Muted": "Stop words. One match and the item is gone, no appeal",
        "Window": "Hours back, default 24",
        "Threshold": "Score 0-100 above which an item ships. Default 60. Noisy - raise it, missing things - lower it",
        "Priority": "The order topic groups appear in the brief",
        "Find sources": "Tick it and discovery runs. The system unticks it when it has finished"
      }
    },
    "sources": {
      "title": "Sources",
      "env": "NOTION_DB_SOURCES",
      "description": "Where to read. Status walks through visible states, so a source never dies quietly.",
      "properties": {
        "Source": {
          "title": {}
        },
        "Address": {
          "url": {}
        },
        "Type": {
          "select": {
            "options": [
              {
                "name": "rss",
                "color": "blue"
              },
              {
                "name": "atom",
                "color": "blue"
              },
              {
                "name": "youtube",
                "color": "red"
              },
              {
                "name": "reddit",
                "color": "orange"
              },
              {
                "name": "hn",
                "color": "orange"
              },
              {
                "name": "json",
                "color": "purple"
              },
              {
                "name": "web_search",
                "color": "gray"
              }
            ]
          }
        },
        "Status": {
          "select": {
            "options": [
              {
                "name": "Proposed",
                "color": "yellow"
              },
              {
                "name": "Verified",
                "color": "blue"
              },
              {
                "name": "Active",
                "color": "green"
              },
              {
                "name": "Degrading",
                "color": "orange"
              },
              {
                "name": "Retired",
                "color": "gray"
              }
            ]
          }
        },
        "Last success": {
          "date": {}
        },
        "Failures in a row": {
          "number": {
            "format": "number"
          }
        },
        "Items per week": {
          "number": {
            "format": "number"
          }
        },
        "Freshness": {
          "date": {}
        },
        "Proposed by": {
          "select": {
            "options": [
              {
                "name": "human",
                "color": "blue"
              },
              {
                "name": "agent",
                "color": "purple"
              }
            ]
          }
        },
        "Note": {
          "rich_text": {}
        }
      },
      "descriptions": {
        "Address": "The feed or endpoint address",
        "Type": "Decides which adapter reads it",
        "Status": "Only Active sources are fetched on a run",
        "Last success": "Set by every successful fetch",
        "Failures in a row": "3 means Degrading, 7 means Retired. Reset by a success",
        "Items per week": "Measured by the validator, not claimed by the model",
        "Freshness": "Date of the newest entry when it was last checked",
        "Note": "Why it was proposed, or why it was retired"
      }
    },
    "feed": {
      "title": "Feed",
      "env": "NOTION_DB_FEED",
      "description": "Only what was sent. The archive and the click record. The seen-index lives in n8n, not here.",
      "properties": {
        "Title": {
          "title": {}
        },
        "Link": {
          "url": {}
        },
        "Hash": {
          "rich_text": {}
        },
        "Published": {
          "date": {}
        },
        "Brief date": {
          "date": {}
        },
        "Score": {
          "number": {
            "format": "number"
          }
        },
        "Reason": {
          "rich_text": {}
        },
        "Duplicates": {
          "number": {
            "format": "number"
          }
        },
        "Opened": {
          "date": {}
        },
        "Verdict": {
          "select": {
            "options": [
              {
                "name": "miss",
                "color": "red"
              },
              {
                "name": "📌 saved",
                "color": "blue"
              }
            ]
          }
        }
      },
      "descriptions": {
        "Link": "The article's own address",
        "Hash": "The row's key. /r?i=... finds the item by it when a link is tapped",
        "Score": "What the model gave it. Seeing the spread is how you set the Threshold on evidence",
        "Reason": "Which signal or criterion matched",
        "Duplicates": "How many sources carried the same story",
        "Opened": "When the link was tapped. Empty means it was not",
        "Verdict": "Set in the weekly review, or by hand"
      }
    },
    "runs": {
      "title": "Runs",
      "env": "NOTION_DB_RUNS",
      "description": "One row a day. Every metric comes from here, so the archive does not have to hold every article ever considered.",
      "properties": {
        "Date": {
          "title": {}
        },
        "Considered": {
          "number": {
            "format": "number"
          }
        },
        "Dropped by rule": {
          "number": {
            "format": "number"
          }
        },
        "Dropped by model": {
          "number": {
            "format": "number"
          }
        },
        "Included": {
          "number": {
            "format": "number"
          }
        },
        "Sources JSON": {
          "rich_text": {}
        },
        "Signals JSON": {
          "rich_text": {}
        },
        "Errors": {
          "rich_text": {}
        },
        "Duration": {
          "number": {
            "format": "number"
          }
        }
      },
      "descriptions": {
        "Sources JSON": "e.g. {\"TechCrunch\": {\"ok\": true, \"items\": 22, \"included\": 2}}",
        "Signals JSON": "How often each signal and muted word fired. A zero for weeks means dead vocabulary",
        "Duration": "Seconds"
      }
    },
    "settings": {
      "title": "Settings",
      "env": "NOTION_DB_SETTINGS",
      "description": "Global switches, so nobody has to open n8n.",
      "properties": {
        "Key": {
          "title": {}
        },
        "Value": {
          "rich_text": {}
        },
        "Note": {
          "rich_text": {}
        }
      },
      "descriptions": {}
    },
    "briefs": {
      "title": "Briefs",
      "env": "NOTION_DB_BRIEFS",
      "description": "One page per morning. This is what the 'full brief' link opens.",
      "properties": {
        "Brief": {
          "title": {}
        },
        "Date": {
          "date": {}
        },
        "Considered": {
          "number": {
            "format": "number"
          }
        },
        "Included": {
          "number": {
            "format": "number"
          }
        }
      },
      "descriptions": {}
    }
  },
  "relations": [
    {
      "from": "sources",
      "property": "Topics",
      "to": "topics",
      "dual": "Sources",
      "description": "Which topics this source serves"
    },
    {
      "from": "feed",
      "property": "Source",
      "to": "sources",
      "dual": "Feed"
    },
    {
      "from": "feed",
      "property": "Topic",
      "to": "topics",
      "dual": "Feed"
    },
    {
      "from": "feed",
      "property": "Brief",
      "to": "briefs",
      "dual": "Items"
    }
  ]
}
